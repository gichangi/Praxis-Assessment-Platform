############################################################
# Assessment Platform — Docker environment variables
# Copy this file to docker/.env and fill in every value.
# Never commit docker/.env to version control.
############################################################

## ── PostgreSQL ────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=postgres
POSTGRES_PORT=5432

## ── JWT (generate with: openssl rand -base64 32) ─────────
# Must be at least 32 characters.
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters
JWT_EXPIRY=3600

## ── Supabase API keys ─────────────────────────────────────
# These are JWTs signed with JWT_SECRET.
# Use https://supabase.com/docs/guides/self-hosting#api-keys
# or run: node -e "require('./tools/gen-keys.js')" to generate.
#
# anon key payload:  { "role": "anon",         "iss": "supabase" }
# service key payload: { "role": "service_role", "iss": "supabase" }
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

## ── URLs ──────────────────────────────────────────────────
# The public-facing URL of the Kong API gateway.
# Used by GoTrue for email redirect links and by the mobile app.
API_EXTERNAL_URL=https://api.your-domain.com

# The URL of your admin portal (Next.js app).
# GoTrue uses this as the default redirect after email confirmation.
SITE_URL=https://admin.your-domain.com

# Comma-separated list of additional allowed redirect URLs.
ADDITIONAL_REDIRECT_URLS=

## ── Email (SMTP) ──────────────────────────────────────────
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=noreply@your-domain.com
SMTP_PASS=smtp-password
SMTP_ADMIN_EMAIL=admin@your-domain.com
# Set to true to skip email confirmation (useful for testing).
ENABLE_EMAIL_AUTOCONFIRM=false

## ── Realtime ──────────────────────────────────────────────
# Generate with: openssl rand -hex 32
REALTIME_SECRET_KEY_BASE=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
REALTIME_DB_ENC_KEY=supabaserealtime

## ── Kong ports ────────────────────────────────────────────
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

## ── Admin portal port ─────────────────────────────────────
ADMIN_PORT=3000

## ── Studio dashboard (optional) ──────────────────────────
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me

## ── Google Sheets sync (optional) ────────────────────────
# Only required if using the sheets-sync edge function.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SPREADSHEET_ID=
